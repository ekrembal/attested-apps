    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "nostr-tools": "^2.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
